# Backend configuration (all values are optional for the prototype)
# Copy this file to .env if needed

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sample data scale factor (km² per pixel ratio unit)
AREA_SCALE_FACTOR=0.25

# Manning roughness coefficient (default: 0.035 for natural rivers)
MANNING_N=0.035

# Discharge model weights (physics vs ML)
PHYSICS_WEIGHT=0.60
ML_WEIGHT=0.40
